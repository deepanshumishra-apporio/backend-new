enum InvestorProfileType {
  INDIVIDUAL @map("individual")

  @@map("investor_profile_type")
}

/// FP accepts resident_individual and nri for an individual profile today.
/// The minor statuses are referenced by FP's own source_of_wealth and
/// income_slab rules, so they are declared here for the minor subdomain.
enum TaxStatus {
  RESIDENT_INDIVIDUAL    @map("resident_individual")
  NRI                    @map("nri")
  RESIDENT_MINOR         @map("resident_minor")
  NON_RESIDENT_MINOR_NRO @map("non_resident_minor_nro")

  @@map("tax_status")
}

enum Gender {
  MALE        @map("male")
  FEMALE      @map("female")
  TRANSGENDER @map("transgender")

  @@map("gender")
}

/// kyc_request.marital_status. FP's KYC vocabulary uses `unmarried`; the
/// investor profile uses `single` for the same idea — see ProfileMaritalStatus.
/// Two vocabularies, like Occupation / KycOccupationType. Do not merge them.
enum MaritalStatus {
  MARRIED   @map("married")
  UNMARRIED @map("unmarried")
  OTHERS    @map("others")

  @@map("marital_status")
}

/// investor_profile.marital_status. Same idea as MaritalStatus, different
/// spelling: FP's profile object returns `single`, never `unmarried`. Mirroring
/// a profile through the KYC enum silently dropped this field to null.
enum ProfileMaritalStatus {
  MARRIED @map("married")
  SINGLE  @map("single")
  OTHERS  @map("others")

  @@map("profile_marital_status")
}

/// investor_profile.occupation. Note the spelling differs from
/// KycOccupationType — FP uses two vocabularies. Do not merge them.
enum Occupation {
  BUSINESS               @map("business")
  PROFESSIONAL           @map("professional")
  RETIRED                @map("retired")
  HOUSE_WIFE             @map("house_wife")
  STUDENT                @map("student")
