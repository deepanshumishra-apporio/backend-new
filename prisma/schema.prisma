// ===========================================================================
// Enums — FP KYC vocabulary
// ===========================================================================

/// Whether a KYC form opens a new KYC record or amends an existing one.
/// FP decides eligibility from the PAN's real status, so this is not a free
/// choice — see the KycForm model.
enum KycFormType {
  FRESH  @map("fresh")
  MODIFY @map("modify")

  @@map("kyc_form_type")
}

enum KycFormStatus {
  /// Eligibility is being checked, asynchronously. Poll.
  UNDER_REVIEW        @map("under_review")
  /// Eligible; fill in the fields FP is asking for.
  CREATED             @map("created")
  /// Everything present — send the investor to the esign URL.
  AWAITING_ESIGN      @map("awaiting_esign")
  /// Esigned, on its way to the KRA.
  AWAITING_SUBMISSION @map("awaiting_submission")
  SUBMITTED           @map("submitted")
  FAILED              @map("failed")
  /// No action within 7 days. Not resumable — start a new form.
  EXPIRED             @map("expired")

  @@map("kyc_form_status")
}

enum KycRequestStatus {
  /// Created but incomplete — see KycRequest.fieldsNeeded.
  PENDING        @map("pending")
  /// All data present; create an Esign and redirect the investor.
  ESIGN_REQUIRED @map("esign_required")
  SUBMITTED      @map("submitted")
  /// Accepted by the KRA.
  SUCCESSFUL     @map("successful")
  REJECTED       @map("rejected")
  /// Not completed within 5 days of creation. Not resumable — start a new one.
  EXPIRED        @map("expired")

  @@map("kyc_request_status")
}

enum IdentityDocumentType {
  AADHAAR @map("aadhaar")

  @@map("identity_document_type")
}

enum DocumentFetchStatus {
  PENDING    @map("pending")
  SUCCESSFUL @map("successful")
  FAILED     @map("failed")
  EXPIRED    @map("expired")

  @@map("document_fetch_status")
}

enum EsignStatus {
  PENDING    @map("pending")
  SUCCESSFUL @map("successful")
  FAILED     @map("failed")

  @@map("esign_status")
}

