  @@map("holding_pattern")
}

/// Which route an order takes to the AMC.
///
/// `cybrillapoa` is FP's ONDC implementation and is the value the API actually
/// expects — `ondc` is also accepted but the documented gateway name for
/// orders is cybrillapoa. Both are modelled so a mirrored order is never
/// silently recorded as the wrong route.
enum OrderGateway {
  RTA         @map("rta")
  CYBRILLAPOA @map("cybrillapoa")
  ONDC        @map("ondc")

  @@map("order_gateway")
}

/// Shared lifecycle of mf_purchase / mf_redemption / mf_switch.
///
/// A pending order expires if it is not confirmed in time: T+7 working days
/// for a purchase, T+1 for a redemption or switch, counted from
/// `scheduledOn`. Expiry surfaces as FAILED with failureCode = order_expiry.
enum MfOrderState {
  /// ONDC gateway only: the gateway is reviewing the order asynchronously.
  UNDER_REVIEW @map("under_review")
  /// Created, not yet ready for submission.
  PENDING      @map("pending")
  /// Payment or settlement in place; ready for the gateway.
  CONFIRMED    @map("confirmed")
  SUBMITTED    @map("submitted")
  SUCCESSFUL   @map("successful")
  FAILED       @map("failed")
  CANCELLED    @map("cancelled")
  /// A previously successful order was reversed by the gateway; units revert.
  REVERSED     @map("reversed")

  @@map("mf_order_state")
}

enum MfPurchaseType {
  /// Fresh purchase — no folio yet, the AMC creates one.
  PURCHASE            @map("purchase")
  /// Into an existing folio.
  ADDITIONAL_PURCHASE @map("additional_purchase")

  @@map("mf_purchase_type")
}

enum RedemptionMode {
  NORMAL  @map("normal")
  /// Liquid schemes that support it: proceeds within ~30 minutes. RTA only.
  INSTANT @map("instant")

  @@map("redemption_mode")
}

enum OrderInitiatedBy {
  INVESTOR    @map("investor")
  DISTRIBUTOR @map("distributor")

  @@map("order_initiated_by")
}

enum OrderInitiatedVia {
  WEB                @map("web")
  MOBILE_APP         @map("mobile_app")
  MOBILE_APP_ANDROID @map("mobile_app_android")
  MOBILE_APP_IOS     @map("mobile_app_ios")
  MOBILE_WEB         @map("mobile_web")
  MOBILE_WEB_ANDROID @map("mobile_web_android")
  MOBILE_WEB_IOS     @map("mobile_web_ios")

  @@map("order_initiated_via")
}

// ===========================================================================
// Enums — FP transaction plan vocabulary (SIP / SWP / STP)
// ===========================================================================

enum PlanState {
  /// Registered with FP, activation attempted automatically.
  CREATED          @map("created")
  /// ONDC gateway only.
  REVIEW_COMPLETED @map("review_completed")
  /// ONDC gateway only.
  CONFIRMED        @map("confirmed")
  /// ONDC gateway only.
  SUBMITTED        @map("submitted")
  /// Only an active plan generates installments.
  ACTIVE           @map("active")
  CANCELLED        @map("cancelled")
  /// Every installment has been generated.
  COMPLETED        @map("completed")
  /// Activation failed.
  FAILED           @map("failed")

  @@map("plan_state")
}

/// Installment cadence. `installmentDay` means different things per frequency:
/// 1-5 (Mon-Fri) for the weekly and fortnightly cadences, 1-28 for the
/// monthly and longer ones, and nothing at all for DAILY.
enum PlanFrequency {
  /// Every business day; market holidays are skipped.
  DAILY              @map("daily")
  /// Every calendar day. Confirmed present in the sandbox scheme thresholds,
  /// but FP gates it per customer — check before offering it.
  CALENDAR_DAY_DAILY @map("calendar_day_daily")
  DAY_IN_A_WEEK      @map("day_in_a_week")
  FOUR_TIMES_A_MONTH @map("four_times_a_month")
  DAY_IN_A_FORTNIGHT @map("day_in_a_fortnight")
  TWICE_A_MONTH      @map("twice_a_month")
  MONTHLY            @map("monthly")
  QUARTERLY          @map("quarterly")
  HALF_YEARLY        @map("half_yearly")
  YEARLY             @map("yearly")

  @@map("plan_frequency")
}

enum PlanPurpose {
  CHILDREN_EDUCATION @map("children_education")
  CHILDREN_MARRIAGE  @map("children_marriage")
  HOUSE              @map("house")
  CAR                @map("car")
  TRAVEL             @map("travel")
  RETIREMENT         @map("retirement")
  OTHERS             @map("others")

  @@map("plan_purpose")
}

enum PlanPaymentMethod {
  MANDATE @map("mandate")

  @@map("plan_payment_method")
}

