// Prisma schema — mutual fund platform on Fintech Primitives (FP / Cybrilla)
//
// ---------------------------------------------------------------------------
// What this schema is
// ---------------------------------------------------------------------------
// FP is the system of record for everything regulated: investor profiles, KYC,
// folios, orders, mandates and payments all live in FP and are reachable at
// https://s.finprim.com with the `x-tenant-id` header. This database is
// therefore TWO things, and the split matters:
//
//   1. Ours alone      — app accounts, phone-OTP challenges, onboarding
//                        progress, audit trail. FP knows nothing about these.
//   2. A mirror of FP  — every model carrying an `fpId`. FP owns the truth;
//                        we keep a local projection so the app can render
//                        lists, filter and paginate without fanning out to FP
//                        on every request.
//
// Rules for the mirrored half:
//   - `fpId` is FP's identifier and the idempotency anchor for every sync.
//     Upsert on it; never insert blind.
//   - `fpOldId` is FP's legacy numeric id. It is NOT redundant — the Payments
//     and Mandates APIs address purchases and bank accounts by this integer,
//     not by the `fpId` string.
//   - Never invent state locally. A mirrored row changes only when FP says so
//     (API response or webhook). Local writes belong on the "ours" side.
//   - `syncedAt` records when we last reconciled the row with FP, so a stale
//     projection is detectable rather than silently wrong.
//
// ---------------------------------------------------------------------------
// Enum values are FP's wire strings
// ---------------------------------------------------------------------------
// FP-mirroring enums use value-level `@map` so the Postgres label is byte
// identical to the JSON FP sends ("resident_individual", not
// "RESIDENT_INDIVIDUAL"). Reading a row then matches reading an API payload,
// which is what you want at 2am during a reconciliation. Enums that are ours
// alone carry no @map — the absence of one tells you FP has no such concept.
//
// Where FP uses two different vocabularies for the same idea, this schema
// keeps two enums rather than flattening them. `Occupation` (investor_profile)
// and `KycOccupationType` (kyc_request) are the clearest example: FP spells
// the same job "house_wife" in one and "housewife" in the other. Merging them
// would silently corrupt one of the two payloads.
//
// ---------------------------------------------------------------------------
// Scope: the individual investor journey
// ---------------------------------------------------------------------------
// Modelled now: KYC check -> digital KYC -> investor profile + contact details,
// bank account, nominee -> MF investment account + folio defaults -> folio ->
// lumpsum and systematic purchase, redemption, switch -> mandate + payment ->
// holdings and returns.
//
// Deliberately left as seams for the later subdomains, so none of them needs a
// destructive migration:
//   minor  — InvestorProfile.guardian*, TaxStatus.RESIDENT_MINOR /
//            NON_RESIDENT_MINOR_NRO, RelatedPartyContact.subject = GUARDIAN,
//            UserInvestorProfile.relationship = GUARDIAN.
//   joint  — MfInvestmentAccount.secondInvestor/thirdInvestor, the full
//            HoldingPattern enum, UserInvestorProfile.relationship =
//            JOINT_HOLDER.
//   agent  — Partner, MfPurchase.partner/euin, MfInvestmentAccount
//            .servicingPartner, UserRole.DISTRIBUTOR.
//   admin  — UserRole.ADMIN / SUPPORT, AuditLog, FpWebhookEvent.
//
// ---------------------------------------------------------------------------
// Numeric conventions (NEVER Float for money — binary floats cannot represent
// decimal currency exactly and drift under accumulation):
//   money (INR)   -> Decimal(18, 2)
//   fund units    -> Decimal(18, 4)   FP allots to 3dp; 4 leaves headroom
//   NAV / price   -> Decimal(12, 4)
//   percentages   -> Decimal(6, 4)    stored as percent, 1.2500 = 1.25%
//   allocation %  -> Decimal(5, 2)    nominee split, 0.00-100.00
//   lat / long    -> Decimal(9, 6)
//
// Connection URLs live in prisma.config.ts, not here (Prisma 7).
// Docs: https://fintechprimitives.com/docs/api/ and https://docs.fintechprimitives.com

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Enums — ours
// ===========================================================================

enum UserRole {
  INVESTOR
  /// Sub-broker / ARN holder acting for investors. The agent subdomain builds
  /// on this plus Partner; nothing else in the schema needs to change.
  DISTRIBUTOR
  ADMIN
  SUPPORT
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

/// How a login account relates to an investor profile.
///
/// One account can reach several profiles (a parent operating a minor's
/// folios, one holder of a joint account) and one profile can be reachable by
/// several accounts. That is why this is a join table and not a column.
enum UserProfileRelationship {
  /// The profile is the account holder's own.
  SELF
  /// Account holder is the guardian of a minor investor. (minor subdomain)
  GUARDIAN
  /// Account holder is a second or third holder. (joint subdomain)
  JOINT_HOLDER
  /// Power of attorney.
  POA
  /// Distributor servicing the investor. (agent subdomain)
  ADVISOR
}

/// Cursor for the stepped onboarding UI — see InvestorOnboarding.
enum OnboardingStage {
  /// PAN checked against the KRAs; we know whether the investor is compliant.
  KYC_CHECK
  /// KYC non-compliant: digital KYC application in flight.
  KYC_REQUEST
  /// Demographic details captured on the investor profile.
  PROFILE
  /// At least one address, phone number and email address recorded.
  CONTACT_DETAILS
  /// Bank account added (and verified, where verification is enabled).
  BANK_ACCOUNT
  /// Nominee declared, or nomination explicitly opted out of.
  NOMINEE
  /// FATCA / tax residency declaration complete.
  FATCA
  /// MF investment account created and folio defaults set.
  INVESTMENT_ACCOUNT
  /// e-mandate registered — only needed before a SIP.
  MANDATE
  /// Ready to transact.
  COMPLETED
}

enum FilePurpose {
  SIGNATURE
  CANCELLED_CHEQUE
  PHOTO
  IPV_VIDEO
  IDENTITY_PROOF
  ADDRESS_PROOF
  OTHER
}

/// Which side of a related party a contact block belongs to.
enum RelatedPartyContactSubject {
  /// The nominee / related party themselves.
  SELF
  /// The nominee's guardian, when the nominee is a minor.
  GUARDIAN
}

/// Frequency dimension of MfSchemeThreshold.
///
/// A near-copy of PlanFrequency, plus NOT_APPLICABLE for the one-off threshold
/// types that have no cadence (lumpsum, withdrawal, switch). It exists as its
/// own enum so the column can be NOT NULL, which is what lets
/// `(scheme, type, frequency)` be a real natural key: Prisma refuses a null
/// inside a compound-unique `where`, so a nullable frequency could not be
/// upserted — every catalogue sync would need a read-then-write instead.
enum SchemeThresholdFrequency {
  /// Our own value, not FP's — the threshold has no frequency dimension.
  NOT_APPLICABLE     @map("not_applicable")
  DAILY              @map("daily")
  CALENDAR_DAY_DAILY @map("calendar_day_daily")
  DAY_IN_A_WEEK      @map("day_in_a_week")
  FOUR_TIMES_A_MONTH @map("four_times_a_month")
  DAY_IN_A_FORTNIGHT @map("day_in_a_fortnight")
  TWICE_A_MONTH      @map("twice_a_month")
  MONTHLY            @map("monthly")
  QUARTERLY          @map("quarterly")
  HALF_YEARLY        @map("half_yearly")
  YEARLY             @map("yearly")

  @@map("scheme_threshold_frequency")
}

/// Transaction-type dimension of MfSchemeThreshold.
enum SchemeThresholdType {
  LUMPSUM
  ADDITIONAL
  WITHDRAWAL
  SWITCH_IN
  SWITCH_OUT
  SIP
  SWP
  STP
}

enum OtpPurpose {
  PHONE_VERIFICATION
  LOGIN
  /// SEBI mandates 2FA before an order reaches the RTA. The verified challenge
  /// is what backs MfPurchase.consent* — see MfPurchase.
  TRANSACTION_APPROVAL
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  /// Too many wrong attempts — the challenge is burnt, request a new one.
  FAILED
  CANCELLED
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  /// Retries exhausted. Needs an operator; see FpWebhookEvent.lastError.
  FAILED
  /// Recognised event we intentionally do not act on.
  IGNORED
}

