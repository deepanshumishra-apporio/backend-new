  AGRICULTURE            @map("agriculture")
  DOCTOR                 @map("doctor")
  FOREX_DEALER           @map("forex_dealer")
  SERVICE                @map("service")
  OTHERS                 @map("others")

  @@map("occupation")
}

/// kyc_request.occupation_type. Same idea as Occupation, different spellings.
enum KycOccupationType {
  BUSINESS          @map("business")
  PROFESSIONAL      @map("professional")
  RETIRED           @map("retired")
  HOUSEWIFE         @map("housewife")
  STUDENT           @map("student")
  PUBLIC_SECTOR     @map("public_sector")
  PRIVATE_SECTOR    @map("private_sector")
  GOVERNMENT_SECTOR @map("government_sector")
  OTHERS            @map("others")

