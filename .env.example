# Copy to .env and fill in real values: cp .env.example .env
# Never put real credentials in this file — it IS committed.

# Optional local demonstration login (email/mobile code 1234).
# Requires NODE_ENV=development or test AND FP_BASE_URL=https://s.finprim.com.
# Never enable this flag on a deployment containing real investor data.
SANDBOX_AUTH_ENABLED=false

# Must be a standard postgresql:// (or postgres://) URL.
#
# A `prisma+postgres://` URL will NOT work. The app talks to Postgres through
# @prisma/adapter-pg, which wraps the `pg` driver, and `pg` does not understand
# that protocol — it silently parses it into a bogus target (no user, no
# password, no database) instead of erroring. src/db/client.ts rejects it up
# front so you get a clear message rather than a dead pool.
#
# Prefer sslmode=verify-full over sslmode=require: `pg` currently treats
# `require` as full verification, but that weakens to libpq semantics (encrypt,
# do not verify the certificate) in pg v9.
#
# If your provider offers a connection pooler (Neon, Supabase, PgBouncer),
# point DATABASE_URL at the POOLED endpoint.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Non-pooled endpoint. The Prisma CLI uses this for migrations when set,
# because DDL and advisory locks need a real session. Omit if not behind a
# pooler — the CLI then falls back to DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@direct-host/dbname?sslmode=verify-full"

# Optional pg pool tuning; src/db/client.ts has defaults.
DATABASE_POOL_MAX="10"
DATABASE_CONNECT_TIMEOUT_MS="15000"
DATABASE_IDLE_TIMEOUT_MS="30000"

# ---------------------------------------------------------------------------
# MSG91 (mobile OTP)
# ---------------------------------------------------------------------------
# authkey from MSG91 dashboard -> Settings -> API. Server-side only.
MSG91_AUTH_KEY=""
# OTP template id from MSG91 dashboard -> Templates. Must be DLT-approved.
MSG91_OTP_TEMPLATE_ID=""
MSG91_BASE_URL="https://control.msg91.com/api/v5"

# ---------------------------------------------------------------------------
# Fixed OTP — DEVELOPMENT ONLY
# ---------------------------------------------------------------------------
# Makes every verification code this exact value and delivers nothing: no SMS,
# no email, no provider of any kind. Login and transaction approval both go
# through the same service, so one value covers both.
#
# The challenge is still real — rate limits, attempt caps, lockouts and expiry
# all behave exactly as in production — so the flow under test is the flow that
# ships. Only the code and its delivery change.
#
# This is a complete authentication bypass for anyone who knows the value. The
# server REFUSES TO BOOT if it is set with NODE_ENV=production, and refuses if
# it is not exactly OTP_LENGTH digits. Takes precedence over OTP_EMAIL_FALLBACK.
OTP_DEV_CODE=""

# ---------------------------------------------------------------------------
# Email OTP fallback — DEVELOPMENT ONLY
# ---------------------------------------------------------------------------
# Delivers the login code by email instead of SMS, for environments with no
# MSG91 account. Every code, for every number anyone types, goes to the single
# OTP_EMAIL_RECIPIENT inbox — so whoever reads that inbox can sign in as
# anybody. The server REFUSES TO BOOT if this is enabled with
# NODE_ENV=production, and refuses if it is enabled but half-configured.
OTP_EMAIL_FALLBACK="false"
OTP_EMAIL_RECIPIENT=""

# Gmail: host smtp.gmail.com, port 465, user = the full address, password = a
# 16-character App Password from myaccount.google.com/apppasswords (requires
# 2-Step Verification). A normal account password will not authenticate.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Defaults to SMTP_USER when unset.
SMTP_FROM=""
MSG91_TIMEOUT_MS="8000"
MSG91_MAX_RETRIES="2"

# OTP policy. MSG91 cannot enforce these — they are ours.
OTP_LENGTH="6"
OTP_TTL_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_SENDS_PER_HOUR="5"
OTP_MAX_SENDS_PER_DAY="10"
OTP_LOCKOUT_MINUTES="30"
OTP_TOKEN_TTL_MINUTES="15"

# ---------------------------------------------------------------------------
# Fintech Primitives (FP / Cybrilla)
# ---------------------------------------------------------------------------
# FP is the system of record for investors, KYC, folios, orders and payments.
# Tenant authentication uses the OAuth2 client_credentials flow, and the token
# it returns can act on EVERY investor in the tenant — so these are
# server-side only and must never reach a browser or a mobile app.
#
# Sandbox base URL is https://s.finprim.com; the tenant id also goes in the
# `x-tenant-id` header on every call.
FP_BASE_URL="https://s.finprim.com"
FP_TENANT_ID=""
FP_CLIENT_ID=""
FP_CLIENT_SECRET=""
FP_TIMEOUT_MS="15000"
# Access tokens last 1800s (see the `expires_in` field). Cache the token and
# refresh it this many seconds before it expires — FP rate-limits callers that
# mint a new token per request.
FP_TOKEN_REFRESH_SKEW_SECONDS="120"

# Pre-verification APIs live behind a different tenant and a different base
# URL. Docs: https://poa.cybrilla.com/docs/additional-apis/pre-verifications
FP_PREVERIFY_BASE_URL="https://api.sandbox.cybrilla.com"
FP_PREVERIFY_AUTH_URL="https://s.finprim.com/v2/auth/cybrillarta/token"
FP_PREVERIFY_CLIENT_ID=""
FP_PREVERIFY_CLIENT_SECRET=""

# Shared secret guarding the webhook operator endpoints
# (POST /api/v1/webhooks/fp/process and GET .../backlog), sent as x-admin-secret.
# FP's own deliveries do NOT carry it: FP does not sign its webhooks, which is
# why the receiver trusts nothing in the body beyond the event id and re-reads
# every object from FP before applying it.
FP_WEBHOOK_ADMIN_SECRET=""

# Express `trust proxy`. Set behind a load balancer so x-forwarded-for is
# honoured — the investor's IP is reported to the RTA as audit data, so it must
# be the real client, not the balancer.
TRUST_PROXY=""

# Port the HTTP server binds. Defaults to 3000.
PORT="3000"

# Which FP order gateway to route through. This platform is ONDC only, so the
# only accepted value is "ondc"; anything else fails at boot. "cybrillapoa" is
# NOT an alias: FP routes it separately, its orders are refused by the ONDC
# payment provider ("Provider ONDC not configured") and never allotted.
#
#   create -> under_review -> (async review) -> pending
#           -> PATCH consent ALONE -> payment -> PATCH state=confirmed
#           -> investor pays at token_url -> submitted -> successful (folio)
FP_ORDER_GATEWAY="ondc"

# This server's public origin, as the investor's browser reaches it. Used to
# build the default payment_postback_url (/api/v1/payments/return/:orderId):
# FP sends the investor there after the payment page, and the order is read
# straight back — saving its folio if it is already allotted. HTTPS in
# production. Leave empty to let FP show its own page instead.
PUBLIC_API_BASE_URL=""

# Optional. Where the return endpoint sends the investor afterwards, usually the
# app's deep link. Only ?orderId=<our id> is appended. Empty shows a plain
# "return to the app" page.
PAYMENT_RETURN_REDIRECT_URL=""

# How often (ms) the server re-reads paid, in-flight purchases from FP and
# applies pending webhooks, so an allotment and its folio are saved even when
# nobody is watching the order. Default 30000; 0 disables the loop.
ORDER_RECONCILE_INTERVAL_MS="30000"

# Origins a client may name in postbackUrl / proofCallbackUrl / esignCallbackUrl.
# Comma-separated https:// origins, no path. REQUIRED for the KYC form journey
# and for mandate authorisation postbacks: with this empty, every endpoint that
# takes a callback URL answers 503 "Callback origins are not configured".
# An open list here is an open redirect, so list exactly your own front ends.
CALLBACK_ALLOWED_ORIGINS="https://app.example.com"

# Whether an unverified payout bank account blocks an order. Leave it unset
# (equivalent to "true").
#
# On ONDC an unverified payout account lets an order be reviewed, consented,
# PAID FOR and confirmed, and only then fails at submission with
# `payout_account_verification_pending` — after the investor's money has moved.
# Set it to "false" ONLY on a sandbox where the penny-drop is not provisioned
# and never returns a verdict at all. Never in production.
FP_REQUIRE_PAYOUT_ACCOUNT_VERIFICATION="true"
